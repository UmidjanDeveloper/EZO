# REVIEW ONLY. No provisioning/deployment or credential creation is authorized.
# New dedicated project only; do not switch an existing local file store blindly.
EZO_ENV=production
EZO_DEPLOYMENT_PROFILE=free-beta
EZO_AUTH_MODE=token
EZO_API_TOKEN=
EZO_DEBUG_TRACES=false
EZO_LOG_LEVEL=INFO
EZO_CORS_ORIGINS=https://YOUR_PRIVATE_FRONTEND_ORIGIN
EZO_FETCH_ALLOW_PRIVATE_NETWORKS=false
DATABASE_URL=postgresql+psycopg://ezo_app.PROJECT:PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=system&connect_timeout=10
EZO_VECTOR_STORE=pgvector
EZO_STORAGE_PROVIDER=supabase
EZO_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Server-only Storage REST credential with service_role access; never Vercel/browser.
EZO_SUPABASE_STORAGE_KEY=
EZO_SUPABASE_STORAGE_BUCKET=ezo-private
EZO_STORAGE_MAX_BYTES=5000000
# No persistent user files go here in this profile. No fake volume marker.
EZO_STORAGE_DIR=/tmp/ezo-scratch
PORT=10000
EZO_LEARNING_ENABLED=false
EZO_RUFLO_ENABLED=false
EZO_WEB_SEARCH_PROVIDER=none
EZO_SCHOLAR_PROVIDER=none
EZO_VOICE_PROVIDERS=none
EZO_IMAGE_PROVIDERS=none
EZO_OCR_PROVIDER=none
EZO_OFFICE_CONVERTER=none
EZO_MAX_UPLOAD_MB=4
EZO_MAX_MESSAGE_CHARS=4000
EZO_RATE_LIMIT_CHAT=5
EZO_RATE_LIMIT_CHAT_PER_DAY=10
EZO_RATE_LIMIT_DEFAULT=60
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=
VOICESTUDIO_URL=
VOICESTUDIO_API_KEY=
EZO_GITHUB_TOKEN=
# Vercel only: EZO_API_URL=https://YOUR_APPROVED_API_ORIGIN
