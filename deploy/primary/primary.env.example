# deploy/primary — non-secret configuration plus provider keys. Copy to primary.env (git-ignored)
# on the host. DATABASE_URL and EZO_API_TOKEN come from secrets/compose.env (bootstrap-secrets.sh).
# REVIEW ONLY: filling this file authorizes nothing; the owner activation checklist does.
EZO_WEB_DOMAIN=ezo.example.com
EZO_API_DOMAIN=api.ezo.example.com
EZO_ACME_EMAIL=
EZO_CORS_ORIGINS=https://ezo.example.com
EZO_ENV=production
EZO_DEPLOYMENT_PROFILE=full
EZO_AUTH_MODE=token
EZO_OWNER_EMAIL=owner@example.com
EZO_DEBUG_TRACES=false
EZO_LOG_LEVEL=INFO
EZO_FETCH_ALLOW_PRIVATE_NETWORKS=false
EZO_STORAGE_PROVIDER=local
EZO_STORAGE_DIR=/app/storage
EZO_VECTOR_STORE=pgvector
EZO_INGESTION_MODE=background
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
EZO_PREFERRED_PROVIDER=gemini
EZO_PROVIDER_MAX_OUTPUT_TOKENS=4096
EZO_PROVIDER_MAX_INPUT_CHARS=512000
EZO_PROVIDER_CALLS_PER_DAY=200
EZO_PROVIDER_CONCURRENCY=1
EZO_PROVIDER_OPERATION_SECONDS=180
EZO_PROVIDER_TIMEOUT=90
EZO_CONTEXT_MESSAGES=20
EZO_CONTEXT_CHARS=40000
EZO_RATE_LIMIT_CHAT=10
EZO_RATE_LIMIT_CHAT_PER_DAY=100
EZO_RATE_LIMIT_DEFAULT=120
EZO_MAX_UPLOAD_MB=5
EZO_VOICE_PROVIDERS=elevenlabs,openai
EZO_ELEVENLABS_VOICE_ID=
EZO_ELEVENLABS_STT_MODEL=scribe_v1
EZO_ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# Uzbek TTS is not verified for this default ElevenLabs model; OpenAI fallback remains explicit.
EZO_ELEVENLABS_TTS_LANGUAGES=en,ru
EZO_VOICE_CALLS_PER_DAY=60
EZO_VOICE_CONCURRENCY=1
EZO_VOICE_MAX_TEXT_CHARS=2000
EZO_VOICE_MAX_AUDIO_MB=5
EZO_VOICE_TIMEOUT_SECONDS=60
VOICESTUDIO_URL=
VOICESTUDIO_API_KEY=
# Existing cloud image adapters; charges are separate. API keys alone do not prove model access.
EZO_IMAGE_PROVIDERS=auto
EZO_IMAGE_MAX_PER_REQUEST=1
EZO_IMAGE_MAX_PER_DECK=1
EZO_IMAGE_QUALITY=low
# API image intentionally excludes native OCR/Office executables. Do not install them here.
EZO_OCR_PROVIDER=none
EZO_OFFICE_CONVERTER=none
EZO_WEB_SEARCH_PROVIDER=auto
TAVILY_API_KEY=
EZO_SCHOLAR_PROVIDER=openalex
EZO_LEARNING_ENABLED=true
EZO_OFFICIAL_SOURCES=
EZO_RUFLO_ENABLED=false
# Consumer/isolated controller commands and their separate-host boundary are in the guide.
# No API Docker socket or automatic Super Admin grant.
