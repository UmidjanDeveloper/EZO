# API host only. Copy inputs into its secret/environment settings, never into Vercel.
# Generate a random token locally with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
EZO_ENV=production
EZO_AUTH_MODE=token
EZO_API_TOKEN=
EZO_DEBUG_TRACES=false
EZO_LOG_LEVEL=INFO
EZO_FETCH_ALLOW_PRIVATE_NETWORKS=false
EZO_CORS_ORIGINS=https://ezo.example.com
# Supabase Connect -> Session pooler (5432), NOT transaction pooler (6543).
# URL-encode the password; use the project's trusted CA file if not in system roots.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT:PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=system&connect_timeout=10
EZO_STORAGE_DIR=/app/storage
EZO_VECTOR_STORE=pgvector
PORT=10000
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Vercel only (root directory apps/web, include files outside root directory):
# EZO_API_URL=https://YOUR_API_HOST
# This URL is public. Never set NEXT_PUBLIC_* to credentials, DATABASE_URL or the owner token.
