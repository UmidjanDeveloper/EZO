# FUTURE DURABLE HOST ONLY — no compatible all-free hosted backend verified.
# Do not apply on Render Free or create a fake .ezo-volume marker.
# Current decision: docs/ZERO_BUDGET_PRIVATE_BETA.md (BLOCKED).
# API host only. Copy inputs into its secret/environment settings, never into Vercel.
# Generate a random token locally with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
EZO_ENV=production
EZO_AUTH_MODE=token
EZO_API_TOKEN=
EZO_DEBUG_TRACES=false
EZO_LOG_LEVEL=INFO
EZO_FETCH_ALLOW_PRIVATE_NETWORKS=false
EZO_CORS_ORIGINS=https://ezo.example.com
# Supabase Connect -> Session pooler (5432), NOT transaction pooler (6543).
# Use deploy/supabase-private-beta-role.sql in a new dedicated project; no admin role.
# Confirm the role/project suffix in Supabase. URL-encode the password.
# Use the project's trusted CA file if it is not in system roots.
DATABASE_URL=postgresql+psycopg://ezo_app.PROJECT:PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=system&connect_timeout=10
EZO_STORAGE_DIR=/app/storage
EZO_VECTOR_STORE=pgvector
PORT=10000
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Vercel only (root directory apps/web, include files outside root directory):
# EZO_API_URL=https://YOUR_API_HOST
# This URL is public. Never set NEXT_PUBLIC_* to credentials, DATABASE_URL or the owner token.

# Zero paid AI usage: leave ALL provider credentials absent/empty (including inherited ones).
TAVILY_API_KEY=
VOICESTUDIO_URL=
VOICESTUDIO_API_KEY=
EZO_WEB_SEARCH_PROVIDER=none
EZO_SCHOLAR_PROVIDER=none
EZO_VOICE_PROVIDERS=none
EZO_IMAGE_PROVIDERS=none
EZO_OCR_PROVIDER=none
EZO_OFFICE_CONVERTER=none
EZO_RUFLO_ENABLED=false
# Conservative request limits; 0 DISABLES the daily limiter, it does not disable paid AI.
EZO_RATE_LIMIT_CHAT=5
EZO_RATE_LIMIT_CHAT_PER_DAY=10
EZO_RATE_LIMIT_DEFAULT=60
EZO_MAX_UPLOAD_MB=5
