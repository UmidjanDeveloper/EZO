{
  "name": "@ezo/face-tracking",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "acceptance": "pnpm build:acceptance && pnpm preview:acceptance",
    "build:acceptance": "vite build demo --config demo/vite.config.mjs --outDir ../acceptance-dist",
    "preview:acceptance": "vite preview demo --config demo/vite.config.mjs --outDir ../acceptance-dist",
    "test:browser": "vite build --config tests/browser/vite.config.mjs && node tests/browser/run.mjs"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32"
  }
}
