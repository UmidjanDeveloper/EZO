{
  "name": "@ezo/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "EZO — Android app (Capacitor): voice conversation, camera, documents, reminders.",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "sync": "vite build && cap sync android",
    "apk:debug": "vite build && cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/camera": "8.2.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/local-notifications": "8.3.1",
    "@capawesome/capacitor-file-picker": "8.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
