# ---------------------------------------------------------------------------
# EZO configuration. Copy this file to ".env" (the setup command does it for
# you) and fill in what you need. NEVER commit .env — it holds your secrets.
# ---------------------------------------------------------------------------

# --- AI providers ------------------------------------------------------------
# Add at least one key. With no key EZO runs in "offline mode" (no AI answers).
# Get keys at:
#   Anthropic: https://console.anthropic.com/settings/keys
#   OpenAI:    https://platform.openai.com/api-keys
#   Gemini:    https://aistudio.google.com/apikey
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: put one provider first in every route (anthropic | openai | gemini).
EZO_PREFERRED_PROVIDER=

# Which model handles which kind of work is configured in
# apps/api/config/models.toml.

# --- Database ------------------------------------------------------------------
# PostgreSQL started by `docker compose up -d db` (or by `python scripts/ezo.py dev`).
DATABASE_URL=postgresql+psycopg://ezo:ezo@localhost:5432/ezo
# Quick mode without Docker (a file database, fine for trying EZO):
# DATABASE_URL=sqlite:///./ezo.db

# --- Security ------------------------------------------------------------------
# local = no login (only for your own computer).
# token = every request needs EZO_API_TOKEN (use this if others can reach EZO).
EZO_AUTH_MODE=local
EZO_API_TOKEN=
EZO_OWNER_EMAIL=owner@ezo.local
EZO_OWNER_NAME=Owner

# Web addresses allowed to call the API (comma separated).
EZO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Requests per minute per computer.
EZO_RATE_LIMIT_CHAT=30
EZO_RATE_LIMIT_DEFAULT=240

# --- Other ---------------------------------------------------------------------
EZO_TIMEZONE=Asia/Tashkent
EZO_LOG_LEVEL=INFO
# Show the developer "trace" panel in the web app.
EZO_DEBUG_TRACES=true

# Where the browser finds the API (only change if you moved the API).
NEXT_PUBLIC_API_URL=http://localhost:8000
