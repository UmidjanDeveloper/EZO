# ---------------------------------------------------------------------------
# EZO configuration. Copy this file to ".env" (the setup command does it for
# you) and fill in what you need. NEVER commit .env — it holds your secrets.
# ---------------------------------------------------------------------------

# --- AI providers ------------------------------------------------------------
# Add at least one key. With no key EZO runs in "offline mode" (no AI answers).
# Get keys at:
#   Anthropic: https://console.anthropic.com/settings/keys
#   OpenAI:    https://platform.openai.com/api-keys
#   Gemini:    https://aistudio.google.com/apikey
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: put one provider first in every route (anthropic | openai | gemini).
EZO_PREFERRED_PROVIDER=

# Which model handles which kind of work is configured in
# apps/api/config/models.toml.

# --- Files, knowledge and research ---------------------------------------------
# Meaning-based search over your files needs an OpenAI or Gemini key above
# (embeddings). Without one, EZO still finds files by keywords.
#
# Web research: with an Anthropic key EZO can use Claude's web search. Or add a
# Tavily key (https://tavily.com, free tier available) for a dedicated search API.
TAVILY_API_KEY=
# auto | anthropic | tavily | none
EZO_WEB_SEARCH_PROVIDER=auto
# Model used for Claude web search (when the provider is anthropic).
EZO_WEB_SEARCH_MODEL=claude-sonnet-5-5
#
# Where uploaded files are kept (default: apps/api/storage).
EZO_STORAGE_DIR=
# Largest file you can upload, in MB.
EZO_MAX_UPLOAD_MB=25
# auto = pgvector when PostgreSQL has it, otherwise a built-in store. (auto | pgvector | local)
EZO_VECTOR_STORE=auto
# background = read files after upload without making you wait. (background | inline)
EZO_INGESTION_MODE=background
# Never set to true on a server: it lets "add link" reach your private network.
EZO_FETCH_ALLOW_PRIVATE_NETWORKS=false

# --- Voice (optional) ------------------------------------------------------------
# Without anything here, voice mode uses the browser's speech (Chrome, Edge, Safari).
# With OPENAI_API_KEY (above) EZO can also use OpenAI speech-to-text and text-to-speech.
# Optional VoiceStudio service (local, separate container: `docker compose --profile voice up`):
#   VOICESTUDIO_URL=http://voicestudio:3900     (Docker)   or http://localhost:3900 (dev mode)
VOICESTUDIO_URL=
# Protects the VoiceStudio API. Any long random text; EZO sends it automatically.
VOICESTUDIO_API_KEY=
# Order to try voice providers: auto (= voicestudio, then openai) or e.g. "openai,voicestudio".
EZO_VOICE_PROVIDERS=auto
# Longest recording accepted for one utterance, in MB (audio is never stored).
EZO_VOICE_MAX_AUDIO_MB=10

# --- Images (optional) -----------------------------------------------------------
# With OPENAI_API_KEY and/or GEMINI_API_KEY (above) EZO can generate and edit images.
# Without them, diagrams still work, and social graphics / logos get an honest placeholder.
# Order to try image providers: auto (= openai, then gemini), e.g. "gemini,openai", or none.
EZO_IMAGE_PROVIDERS=auto
# Exact model IDs change over time: check your provider's current list.
EZO_OPENAI_IMAGE_MODEL=gpt-image-2
EZO_GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Image calls are paid. low | medium | high (higher costs more).
EZO_IMAGE_QUALITY=medium
# At most this many images for one request, and for one presentation (0 = no deck images).
EZO_IMAGE_MAX_PER_REQUEST=4
EZO_IMAGE_MAX_PER_DECK=4

# --- Multi-agent orchestration (optional, advanced) -----------------------------
# EZO coordinates several agents itself ("native"). Ruflo is an OPTIONAL external
# orchestrator: it is off by default, never required, and in this version EZO still runs
# missions natively even when it is enabled (see docs/RUFLO_INTEGRATION_PLAN.md).
EZO_ORCHESTRATION_PROVIDER=native
EZO_RUFLO_ENABLED=false
# Command that starts Ruflo's MCP server, pinned to a reviewed version, e.g.
#   EZO_RUFLO_COMMAND=npx -y ruflo@<reviewed-version> mcp start
EZO_RUFLO_COMMAND=
# Longest time one mission step may take, in seconds.
EZO_RUFLO_TIMEOUT_SECONDS=600

# --- Database ------------------------------------------------------------------
# PostgreSQL started by `docker compose up -d db` (or by `python scripts/ezo.py dev`).
DATABASE_URL=postgresql+psycopg://ezo:ezo@localhost:5432/ezo
# Quick mode without Docker (a file database, fine for trying EZO):
# DATABASE_URL=sqlite:///./ezo.db

# --- Security ------------------------------------------------------------------
# local = no login (only for your own computer).
# token = every request needs EZO_API_TOKEN (use this if others can reach EZO).
EZO_AUTH_MODE=local
EZO_API_TOKEN=
EZO_OWNER_EMAIL=owner@ezo.local
EZO_OWNER_NAME=Owner

# Web addresses allowed to call the API (comma separated).
EZO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Requests per minute per computer.
EZO_RATE_LIMIT_CHAT=30
EZO_RATE_LIMIT_DEFAULT=240

# --- Other ---------------------------------------------------------------------
EZO_TIMEZONE=Asia/Tashkent
EZO_LOG_LEVEL=INFO
# Show the developer "trace" panel in the web app.
EZO_DEBUG_TRACES=true

# Where the browser finds the API (only change if you moved the API).
NEXT_PUBLIC_API_URL=http://localhost:8000
